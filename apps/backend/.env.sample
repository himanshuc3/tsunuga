TSUNUGA_PRIMARY.ENV="local"

TSUNUGA_SERVER.PORT="8080"
TSUNUGA_SERVER.READ_TIMEOUT="30"
TSUNUGA_SERVER.WRITE_TIMEOUT="30"
TSUNUGA_SERVER.IDLE_TIMEOUT="60"
TSUNUGA_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3000"

TSUNUGA_DATABASE.HOST="localhost"
TSUNUGA_DATABASE.PORT="5432"
TSUNUGA_DATABASE.USER="postgres"
TSUNUGA_DATABASE.PASSWORD=""
TSUNUGA_DATABASE.NAME="boilerplate"
TSUNUGA_DATABASE.SSL_MODE="disable"
TSUNUGA_DATABASE.MAX_OPEN_CONNS="25"
TSUNUGA_DATABASE.MAX_IDLE_CONNS="25"
TSUNUGA_DATABASE.CONN_MAX_LIFETIME="300"
TSUNUGA_DATABASE.CONN_MAX_IDLE_TIME="300"

TSUNUGA_AUTH.SECRET_KEY="secret"

TSUNUGA_INTEGRATION.RESEND_API_KEY="resend_key"

TSUNUGA_REDIS.ADDRESS="redis://localhost:6379"

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Service Identity
TSUNUGA_OBSERVABILITY.SERVICE_NAME="boilerplate"
TSUNUGA_OBSERVABILITY.ENVIRONMENT="development"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Basic Logging Settings
TSUNUGA_OBSERVABILITY.LOGGING.LEVEL="debug"
TSUNUGA_OBSERVABILITY.LOGGING.FORMAT="console"
TSUNUGA_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# ============================================================================
# NEW RELIC CONFIGURATION
# ============================================================================

# New Relic APM
TSUNUGA_OBSERVABILITY.NEW_RELIC.LICENSE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TSUNUGA_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="true"
TSUNUGA_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="true"
TSUNUGA_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# ============================================================================
# HEALTH CHECKS CONFIGURATION
# ============================================================================

# Health Check Settings
TSUNUGA_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
TSUNUGA_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
TSUNUGA_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
TSUNUGA_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis"