TANGO_PRIMARY.ENV="local"

TANGO_SERVER.PORT="8080"
TANGO_SERVER.READ_TIMEOUT="30"
TANGO_SERVER.WRITE_TIMEOUT="30"
TANGO_SERVER.IDLE_TIMEOUT="60"
TANGO_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3000"

TANGO_DATABASE.HOST="localhost"
TANGO_DATABASE.PORT="5432"
TANGO_DATABASE.USER="postgres"
TANGO_DATABASE.PASSWORD="postgres"
TANGO_DATABASE.NAME="myapp"
TANGO_DATABASE.SSL_MODE="disable"
TANGO_DATABASE.MAX_OPEN_CONNS="25"
TANGO_DATABASE.MAX_IDLE_CONNS="25"
TANGO_DATABASE.CONN_MAX_LIFETIME="300"
TANGO_DATABASE.CONN_MAX_IDLE_TIME="300"

TANGO_AUTH.SECRET_KEY="secret"

TANGO_INTEGRATION.RESEND_API_KEY="resend_key"

TANGO_REDIS.ADDRESS="redis://localhost:6379"

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Service Identity
TANGO_OBSERVABILITY.SERVICE_NAME="boilerplate"
TANGO_OBSERVABILITY.ENVIRONMENT="development"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Basic Logging Settings
TANGO_OBSERVABILITY.LOGGING.LEVEL="debug"
TANGO_OBSERVABILITY.LOGGING.FORMAT="console"
TANGO_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# ============================================================================
# NEW RELIC CONFIGURATION
# ============================================================================

# New Relic APM
TANGO_OBSERVABILITY.NEW_RELIC.LICENSE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TANGO_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="true"
TANGO_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="true"
TANGO_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# ============================================================================
# HEALTH CHECKS CONFIGURATION
# ============================================================================

# Health Check Settings
TANGO_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
TANGO_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
TANGO_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
TANGO_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis"

# ============================================================================
# AWS CONFIGURATION
# ============================================================================

TANGO_AWS.REGION=""
TANGO_AWS.ACCESS_KEY_ID=""
TANGO_AWS.SECRET_ACCESS_KEY=""
TANGO_AWS.UPLOAD_BUCKET=""
TANGO_AWS.ENDPOINT_URL=""

# ============================================================================
# MISC CONFIG
# ============================================================================

TANGO_CONTENT_DIR = "./content"